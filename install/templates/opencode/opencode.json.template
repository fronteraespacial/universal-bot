{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "mcp": {
    "{{BOT_SLUG}}": {
      "type": "local",
      "command": ["bash", "{{BOT_ROOT}}/run_mcp.sh"],
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "PATH": "{{VENV_BIN}}:{{OPENCODE_BIN_DIR}}:/usr/local/bin:/usr/bin:/bin"
      }
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "write": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "skill": {
      "*": "allow"
    },
    "webfetch": "allow"
  }
}
